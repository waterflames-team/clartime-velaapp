@import "../../../common/style/universal.css";
@import "../../../common/style/component.css";
.content {
  width: 432px;
  height: 514px;
}

.component-about-textContent-container {
  position: absolute;
  top: 72px;
  display: flex;
  flex-direction: column;
  padding: 12px;

  width: 392px;
}
.component-about-textContent-textSubTitle {
  font-size: 32px;
  font-weight: 500;
  letter-spacing: 0px;
  line-height: 44.8px;
  color: rgba(255, 255, 255, 0.6);
  text-align: left;
}

.component-about-textBlock {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: -4px;
}
.component-about-textContent-text {
  color: rgba(255, 255, 255, 0.60);
  font-size: 20px;
  font-weight: 380;
}
.component-about-textContent-textBold {
  color: #FFF;
  font-size: 32px;
  font-weight: 550;
  /* font-weight: 380; */
}
</style>
